# Copiaza in `.env` (ignorat de git) pentru rulare locala: `npm start`.
# Pe Render NU folosi acest fisier — variabilele se pun in Dashboard, iar
# render.yaml le cere singur la crearea Blueprint-ului.

# --- Cache -------------------------------------------------------------------
# Lasate goale => cache pe SQLite local (data/), ceea ce e exact ce vrei local.
# Completate => comuta pe Redis. Din Upstash -> baza ta -> tab REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin -------------------------------------------------------------------
# Protejeaza rutele /admin/*. Local poti lasa gol (cade pe default-ul din cod).
ADMIN_KEY=

# --- Surse optionale ---------------------------------------------------------
# Goale => sursa respectiva e sarita, restul merg normal.
SUBSRO_API_KEY=
TITRARI_COOKIE=

# --- RegieLive ---------------------------------------------------------------
# Optionala: nesetata, codul foloseste cheia comuna din sursa.
RL_API_KEY=
